(* book_js -- the JS of the outside reads and of book content (keyword: outside read, book content) *)
(* Beside js_emitter.bats, whose sections it leaves as they are: the forms that *)
(* hold it are the book forms (emit_js_all_book), so no earlier form changes. *)

#include "share/atspre_staload.hats"

#use builder as B
#use css as C
staload CB = "css/src/book.sats"

(* ============================================================
   The outside reads (outside.bats): tables of their own
   ============================================================ *)

#pub fun emit_js_outside {n:nat | n + 6224 <= $B.BUILDER_CAP}
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 6224] $B.builder(m)): void

implement emit_js_outside (b) = let
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // --- Outside reads (outside.bats, keyword: outside read) ---\n")
  val () = $B.bput(b,"  // Handles of bytes that came from outside the program (a picked or dropped\n")
  val () = $B.bput(b,"  // file, the body of an http(s) GET, the browser's decompression of those)\n")
  val () = $B.bput(b,"  // live in tables of their own, which only these atoms fill: an ordinary\n")
  val () = $B.bput(b,"  // handle is never found here, and none made here is found in the ordinary\n")
  val () = $B.bput(b,"  // tables\n")
  val () = $B.bput(b,"  const outsideFilesPending = new Map(), outsideFiles = new Map(), outsideNames = new Map();\n")
  val () = $B.bput(b,"  const outsideBlobsPending = new Map(), outsideBlobs = new Map();\n")
  val () = $B.bput(b,"  let nextOutside = 1;\n")
  val () = $B.bput(b,"  function outsideBlob(bytes) { const h = nextOutside++; outsideBlobsPending.set(h, bytes); return h; }\n")
  val () = $B.bput(b,"  function outsideReadFile(f, resolverId) {\n")
  val () = $B.bput(b,"    if (!f) { instance.exports.bats_on_file_open(resolverId, 0); return; }\n")
  val () = $B.bput(b,"    const reader = new FileReader();\n")
  val () = $B.bput(b,"    reader.onload = () => {\n")
  val () = $B.bput(b,"      const h = nextOutside++;\n")
  val () = $B.bput(b,"      outsideFilesPending.set(h, new Uint8Array(reader.result));\n")
  val () = $B.bput(b,"      outsideNames.set(h, f.name || '');\n")
  val () = $B.bput(b,"      instance.exports.bats_on_file_open(resolverId, h);\n")
  val () = $B.bput(b,"    };\n")
  val () = $B.bput(b,"    reader.onerror = () => instance.exports.bats_on_file_open(resolverId, -1);\n")
  val () = $B.bput(b,"    reader.readAsArrayBuffer(f);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsFileOpenAtOutside(idPtr, idLen, i, resolverId) {\n")
  val () = $B.bput(b,"    const el = getEl(readIdFromPtr(idPtr, idLen));\n")
  val () = $B.bput(b,"    outsideReadFile(el && el.files ? el.files[i] : null, resolverId);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsDroppedOpenAtOutside(i, resolverId) { outsideReadFile(droppedFiles[i], resolverId); }\n")
  val () = $B.bput(b,"  function batsJsFileClaimOutside(h) {\n")
  val () = $B.bput(b,"    const d = outsideFilesPending.get(h);\n")
  val () = $B.bput(b,"    if (!d) return -1;\n")
  val () = $B.bput(b,"    outsideFilesPending.delete(h); outsideFiles.set(h, d);\n")
  val () = $B.bput(b,"    return d.length;\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsFileReadOutside(h, off, len, outPtr) {\n")
  val () = $B.bput(b,"    new Uint8Array(instance.exports.memory.buffer).set(outsideFiles.get(h).subarray(off, off + len), outPtr);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsFileCloseOutside(h) { outsideFiles.delete(h); outsideNames.delete(h); }\n")
  val () = $B.bput(b,"  function batsJsFileStoreOutside(p, n) { const h = nextOutside++; outsideFiles.set(h, readBytes(p, n)); return h; }\n")
  val () = $B.bput(b,"  function batsJsFileNameOutside(h) { const n = outsideNames.get(h); return n ? pendBlob(new TextEncoder().encode(n)) : 0; }\n")
  val () = $B.bput(b,"  function batsJsFileBlobUrlOutside(h, off, len, mp, ml) {\n")
  val () = $B.bput(b,"    const d = outsideFiles.get(h);\n")
  val () = $B.bput(b,"    if (!d) return 0;\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      return pendBlob(new TextEncoder().encode(URL.createObjectURL(new Blob([d.subarray(off, off + len)], { type: readString(mp, ml) }))));\n")
  val () = $B.bput(b,"    } catch (e) { return 0; }\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsBlobClaimOutside(h) {\n")
  val () = $B.bput(b,"    const d = outsideBlobsPending.get(h);\n")
  val () = $B.bput(b,"    if (!d) return -1;\n")
  val () = $B.bput(b,"    outsideBlobsPending.delete(h); outsideBlobs.set(h, d);\n")
  val () = $B.bput(b,"    return d.length;\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsBlobReadOutside(h, off, len, outPtr) {\n")
  val () = $B.bput(b,"    new Uint8Array(instance.exports.memory.buffer).set(outsideBlobs.get(h).subarray(off, off + len), outPtr);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsBlobFreeOutside(h) { outsideBlobs.delete(h); }\n")
  (* The browser's decompression of bytes it holds as outside: the method is the
     program's, the bytes are not *)
  val () = $B.bput(b,"  function batsJsDecompressOutside(dataPtr, dataLen, method, resolverId) {\n")
  val () = $B.bput(b,"    const compressed = readBytes(dataPtr, dataLen);\n")
  val () = $B.bput(b,"    const finish = (bytes) => instance.exports.bats_on_decompress_complete(resolverId, bytes ? outsideBlob(bytes) : 0);\n")
  val () = $B.bput(b,"    if (method === 0) { finish(compressed); return; }\n")
  val () = $B.bput(b,"    const format = { 1: 'gzip', 2: 'deflate', 8: 'deflate-raw' }[method];\n")
  val () = $B.bput(b,"    if (!format || typeof DecompressionStream === 'undefined') { finish(null); return; }\n")
  val () = $B.bput(b,"    new Response(new Blob([compressed]).stream().pipeThrough(new DecompressionStream(format))).arrayBuffer()\n")
  val () = $B.bput(b,"      .then((buf) => finish(new Uint8Array(buf)), () => finish(null));\n")
  val () = $B.bput(b,"  }\n")
  (* A GET and nothing else: a URL of another scheme than http: or https: is not
     fetched, and a body is kept only when the final URL (after redirects) is
     http: or https: too. A data: URL is the bytes themselves and a blob: URL can
     hold bytes the program stored, so neither counts *)
  val () = $B.bput(b,"  async function batsJsFetchOutside(urlPtr, urlLen, resolverId) {\n")
  val () = $B.bput(b,"    let h = 0;\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      const u = new URL(readString(urlPtr, urlLen), document.baseURI);\n")
  val () = $B.bput(b,"      if (u.protocol === 'http:' || u.protocol === 'https:') {\n")
  val () = $B.bput(b,"        const r = await fetch(u.href, { method: 'GET' });\n")
  val () = $B.bput(b,"        if (/^https?:\\/\\//i.test(r.url)) h = outsideBlob(new Uint8Array(await r.arrayBuffer()));\n")
  val () = $B.bput(b,"      }\n")
  val () = $B.bput(b,"    } catch (e) {}\n")
  val () = $B.bput(b,"    instance.exports.bats_on_fetch_complete(resolverId, h);\n")
  val () = $B.bput(b,"  }\n")
  (* The second IndexedDB database, bats-outside (version 1, one store files),
     opened by its own openOutsideDB. Only the outside atoms write it, so idb_put
     cannot forge an outside copy; the bats database and its version are
     unchanged *)
  val () = $B.bput(b,"  let outsideDbPromise = null;\n")
  val () = $B.bput(b,"  function openOutsideDB() {\n")
  val () = $B.bput(b,"    if (!outsideDbPromise) {\n")
  val () = $B.bput(b,"      const opening = new Promise((resolve, reject) => {\n")
  val () = $B.bput(b,"        const req = indexedDB.open('bats-outside', 1);\n")
  val () = $B.bput(b,"        req.onupgradeneeded = () => { req.result.createObjectStore('files'); };\n")
  val () = $B.bput(b,"        req.onsuccess = () => resolve(req.result);\n")
  val () = $B.bput(b,"        req.onerror = () => reject(req.error);\n")
  val () = $B.bput(b,"      });\n")
  val () = $B.bput(b,"      outsideDbPromise = opening;\n")
  val () = $B.bput(b,"      opening.catch(() => { if (outsideDbPromise === opening) outsideDbPromise = null; });\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    return outsideDbPromise;\n")
  val () = $B.bput(b,"  }\n")
  (* A write answers 0, -1 the database could not be used, -2 the transaction
     aborted; a read the handle of a file, 0 for nothing there, -1 it failed *)
  val () = $B.bput(b,"  function outsideWrite(keyPtr, keyLen, resolverId, change) {\n")
  val () = $B.bput(b,"    const key = readString(keyPtr, keyLen);\n")
  val () = $B.bput(b,"    openOutsideDB().then((db) => {\n")
  val () = $B.bput(b,"      try {\n")
  val () = $B.bput(b,"        const tx = db.transaction('files', 'readwrite'); change(tx.objectStore('files'), key);\n")
  val () = $B.bput(b,"        tx.oncomplete = () => instance.exports.bats_on_file_open(resolverId, 0);\n")
  val () = $B.bput(b,"        tx.onabort = () => instance.exports.bats_on_file_open(resolverId, -2);\n")
  val () = $B.bput(b,"      } catch (e) { instance.exports.bats_on_file_open(resolverId, -1); }\n")
  val () = $B.bput(b,"    }, () => instance.exports.bats_on_file_open(resolverId, -1));\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsFileIdbPutOutside(keyPtr, keyLen, h, resolverId) {\n")
  val () = $B.bput(b,"    const data = outsideFiles.get(h);\n")
  val () = $B.bput(b,"    outsideWrite(keyPtr, keyLen, resolverId, (store, key) => { store.put(data, key); });\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsFileIdbDeleteOutside(keyPtr, keyLen, resolverId) {\n")
  val () = $B.bput(b,"    outsideWrite(keyPtr, keyLen, resolverId, (store, key) => { store.delete(key); });\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsFileIdbGetOutside(keyPtr, keyLen, resolverId) {\n")
  val () = $B.bput(b,"    const key = readString(keyPtr, keyLen);\n")
  val () = $B.bput(b,"    openOutsideDB().then((db) => {\n")
  val () = $B.bput(b,"      try {\n")
  val () = $B.bput(b,"        const req = db.transaction('files', 'readonly').objectStore('files').get(key);\n")
  val () = $B.bput(b,"        req.onsuccess = () => {\n")
  val () = $B.bput(b,"          if (req.result === undefined) { instance.exports.bats_on_file_open(resolverId, 0); return; }\n")
  val () = $B.bput(b,"          const h = nextOutside++; outsideFilesPending.set(h, new Uint8Array(req.result));\n")
  val () = $B.bput(b,"          instance.exports.bats_on_file_open(resolverId, h);\n")
  val () = $B.bput(b,"        };\n")
  val () = $B.bput(b,"        req.onerror = () => instance.exports.bats_on_file_open(resolverId, -1);\n")
  val () = $B.bput(b,"      } catch (e) { instance.exports.bats_on_file_open(resolverId, -1); }\n")
  val () = $B.bput(b,"    }, () => instance.exports.bats_on_file_open(resolverId, -1));\n")
  val () = $B.bput(b,"  }\n")
in end

(* ============================================================
   Book content (book_content.bats)
   ============================================================ *)

#pub fun emit_js_book {n:nat | n + 14355 <= $B.BUILDER_CAP}
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 14355] $B.builder(m)): void

(* The refused list, once, for both checks of a sheet and of a style, GENERATED
   from css's table (keyword: refused table, bats-lang/css#88, bridge#267):
   css's book_refused_count and book_refused_entry are the one list that
   book_refused (css's src/book.bats) reads, and BOOK_REFUSED below is written
   from them entry by entry, so no copy of an entry is in bridge. An entry is
   written as a JS string of single quotes: a printable ASCII character as it
   is (a backslash or a quote after a backslash), any other as U+FFFD, which
   no text matches; css's entries are printable ASCII (a lower case match, at
   most 11 bytes), and tests/dynamic/book compares the emitted list with
   css's table, so a change there is seen. The sizes are in the types: an
   entry of at most 11 characters of at most 6 bytes each, in quotes and
   followed by a comma and a space, is at most 70 bytes. tests/dynamic/book
   plays each entry (check.mjs, one line for each) *)
fn put_js_char {c:int}{n:nat | n + 6 <= $B.BUILDER_CAP}
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 6] $B.builder(m), c: int(c)): void =
  if c = 92 then let
    val () = $B.put_char(b, 92)
  in $B.put_char(b, 92) end
  else if c = 39 then let
    val () = $B.put_char(b, 92)
  in $B.put_char(b, 39) end
  else if c >= 32 then (if c < 127 then $B.put_char(b, c) else $B.bput(b, "\\ufffd"))
  else $B.bput(b, "\\ufffd")

fun put_js_chars {sn:nat}{at:nat | at <= sn}{n:nat | n + 6 * (sn - at) <= $B.BUILDER_CAP} .<sn - at>.
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 6 * (sn - at)] $B.builder(m),
   s: string(sn), len: int(sn), at: int(at)): void =
  if at >= len then ()
  else let
    val () = put_js_char(b, char2int1(string_get_at(s, at)))
  in put_js_chars(b, s, len, at + 1) end

(* Entries i to cnt - 1 of css's table. The getter takes an index below 17 (css's
   type) and cnt is at most 17 and is css's count: a table of 18 entries
   fails at the call of this function with the count, one of 16 at the getter *)
fun put_refused_entries {cnt:nat | cnt <= 17}{i:nat | i <= cnt}{n:nat | n + 70 * (cnt - i) <= $B.BUILDER_CAP} .<cnt - i>.
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 70 * (cnt - i)] $B.builder(m),
   cnt: int(cnt), i: int(i)): void =
  if i >= cnt then ()
  else let
    val entry = $CB.book_refused_entry(i)
    val () = $B.put_char(b, 39)
    val () = put_js_chars(b, entry, g1u2i(string1_length(entry)), 0)
    val () = $B.bput(b, "', ")
  in put_refused_entries(b, cnt, i + 1) end

implement emit_js_book (b) = let
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // --- Book content (book_content.bats, keyword: book content) ---\n")
  val () = $B.bput(b,"  // Opcodes 13 to 20 are honoured only by batsDomFlushBook, which only the book\n")
  val () = $B.bput(b,"  // stream's dom_flush_book calls; both flushes read the stream operation by\n")
  val () = $B.bput(b,"  // operation (each one's length is known) and hand the ordinary operations that\n")
  val () = $B.bput(b,"  // need no check to the ordinary flush, in runs\n")
  val () = $B.bput(b,"  const bookPlainFlush = batsDomFlush;\n")
  val () = $B.bput(b,"  const bookSheets = new Map(), bookFaces = new Map(), bookPending = new Map(), bookStylePending = new Map(), bookLogged = new Set();\n")
  val () = $B.bput(b,"  const BOOK_REFUSED = [")
  val () = put_refused_entries(b, $CB.book_refused_count (), 0)
  val () = $B.bput(b,"];\n")
  val () = $B.bput(b,"  function bookRefuse(what) { if (!bookLogged.has(what)) { bookLogged.add(what); console.error('bats: book refused: ' + what); } }\n")
  val () = $B.bput(b,"  function bookContainerOf(el) { return el && el.closest ? el.closest('[data-book-container]') : null; }\n")
  val () = $B.bput(b,"  function bookGet(cid) { const c = getEl(cid); return c && c.getAttribute('data-book-container') === cid ? c : null; }\n")
  val () = $B.bput(b,"  function bookContain(c) {\n")
  val () = $B.bput(b,"    c.style.setProperty('contain', 'layout paint style', 'important');\n")
  val () = $B.bput(b,"    c.style.setProperty('isolation', 'isolate', 'important');\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function bookTextRefused(text) { const low = text.toLowerCase(); return BOOK_REFUSED.find((s) => low.includes(s)) || ''; }\n")
  (* The selectors of a rule: each complex selector of the list (split at a comma
     outside parentheses, brackets and strings) starts with the container's prefix *)
  val () = $B.bput(b,"  function bookSelectorsOk(sel, prefix) {\n")
  val () = $B.bput(b,"    let depth = 0, quote = '', part = '';\n")
  val () = $B.bput(b,"    const parts = [];\n")
  val () = $B.bput(b,"    for (const ch of sel) {\n")
  val () = $B.bput(b,"      if (quote) { part += ch; if (ch === quote) quote = ''; continue; }\n")
  val () = $B.bput(b,"      if (ch === '\"' || ch === \"'\") { quote = ch; part += ch; continue; }\n")
  val () = $B.bput(b,"      if (ch === '(' || ch === '[') depth++;\n")
  val () = $B.bput(b,"      if (ch === ')' || ch === ']') { depth--; if (depth < 0) return false; }\n")
  val () = $B.bput(b,"      if (ch === ',' && depth === 0) { parts.push(part); part = ''; continue; }\n")
  val () = $B.bput(b,"      part += ch;\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    parts.push(part);\n")
  val () = $B.bput(b,"    return depth === 0 && !quote && parts.every((s) => s.trimStart().startsWith(prefix));\n")
  val () = $B.bput(b,"  }\n")
  (* A sheet: the refused list, no at-rule but @media and @supports (and not
     inside one), braces at most 2 deep (the second only inside an @media or
     @supports block), every selector with the container's prefix, a statement
     only inside a declaration block, and every block closed *)
  val () = $B.bput(b,"  function bookSheetOk(text, cid) {\n")
  val () = $B.bput(b,"    if (bookTextRefused(text)) return false;\n")
  val () = $B.bput(b,"    const prefix = '[data-book-container=\"' + cid + '\"] ';\n")
  val () = $B.bput(b,"    const stack = [];\n")
  val () = $B.bput(b,"    let prelude = '', quote = '', rules = 0;\n")
  val () = $B.bput(b,"    for (const ch of text) {\n")
  val () = $B.bput(b,"      const top = stack[stack.length - 1];\n")
  val () = $B.bput(b,"      if (quote) { prelude += ch; if (ch === quote) quote = ''; continue; }\n")
  val () = $B.bput(b,"      if (ch === '\"' || ch === \"'\") { quote = ch; prelude += ch; continue; }\n")
  val () = $B.bput(b,"      if (ch === '@' && top === 'rule') return false;\n")
  val () = $B.bput(b,"      if (ch === '{') {\n")
  val () = $B.bput(b,"        if (top === 'rule') return false;\n")
  val () = $B.bput(b,"        const p = prelude.trim();\n")
  val () = $B.bput(b,"        if (p.startsWith('@')) {\n")
  val () = $B.bput(b,"          if (stack.length > 0 || !/^@(media|supports)(?![A-Za-z0-9_-])/i.test(p)) return false;\n")
  val () = $B.bput(b,"          stack.push('at');\n")
  val () = $B.bput(b,"        } else {\n")
  val () = $B.bput(b,"          if (stack.length > 1 || !bookSelectorsOk(p, prefix) || ++rules > 16384) return false;\n")
  val () = $B.bput(b,"          stack.push('rule');\n")
  val () = $B.bput(b,"        }\n")
  val () = $B.bput(b,"        prelude = '';\n")
  val () = $B.bput(b,"      } else if (ch === '}') {\n")
  val () = $B.bput(b,"        if (!stack.length) return false;\n")
  val () = $B.bput(b,"        stack.pop(); prelude = '';\n")
  val () = $B.bput(b,"      } else if (ch === ';') {\n")
  val () = $B.bput(b,"        if (top !== 'rule') return false;\n")
  val () = $B.bput(b,"      } else if (top !== 'rule') prelude += ch;\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    return !stack.length && !quote && prelude.trim() === '';\n")
  val () = $B.bput(b,"  }\n")
  (* style and data-book-* writes of the ordinary operations: never on an
     element inside a container other than the container itself, and
     data-book-* on no element at all *)
  val () = $B.bput(b,"  function bookAttrRefused(el, name) {\n")
  val () = $B.bput(b,"    const n = name.toLowerCase();\n")
  val () = $B.bput(b,"    const book = n.startsWith('data-book-');\n")
  val () = $B.bput(b,"    const inner = n === 'style' && !!bookContainerOf(el) && bookContainerOf(el) !== el;\n")
  val () = $B.bput(b,"    if (book || inner) bookRefuse(book ? 'data-book-* attribute' : 'style inside a container');\n")
  val () = $B.bput(b,"    return book || inner;\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function bookStrip(el) {\n")
  val () = $B.bput(b,"    for (const e of [el, ...el.querySelectorAll('*')]) {\n")
  val () = $B.bput(b,"      e.removeAttribute('style');\n")
  val () = $B.bput(b,"      for (const a of [...e.attributes]) if (a.name.toLowerCase().startsWith('data-book-')) e.removeAttribute(a.name);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"  }\n")
  (* A container that is no longer in the document drops its sheets and faces *)
  val () = $B.bput(b,"  function bookSweep() {\n")
  val () = $B.bput(b,"    for (const cid of [...bookSheets.keys()]) if (!bookGet(cid)) {\n")
  val () = $B.bput(b,"      const dead = new Set(bookSheets.get(cid)); bookSheets.delete(cid);\n")
  val () = $B.bput(b,"      document.adoptedStyleSheets = document.adoptedStyleSheets.filter((s) => !dead.has(s));\n")
  val () = $B.bput(b,"    }\n")
