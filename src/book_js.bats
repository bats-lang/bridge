  val () = $B.bput(b,"  const BOOK_CANVAS = { 64: 16, 65: 16, 66: 16, 67: 0, 68: 8, 69: 8, 70: 21, 71: 0, 72: 0, 73: 0, 74: 4, 75: 4, 76: 4, 80: 0, 81: 0, 82: 8, 83: 4, 84: 8 };\n")
