(* The imports of the book forms *)
#pub fun emit_js_imports_book {n:nat | n + 1037 <= $B.BUILDER_CAP}
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 1037] $B.builder(m)): void

implement emit_js_imports_book (b) = let
  val () = $B.bput(b,"      bats_dom_flush_book: batsDomFlushBook,\n")
  val () = $B.bput(b,"      bats_js_book_font_add: batsJsBookFontAdd,\n")
