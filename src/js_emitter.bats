  val () = $B.bput(b,"    try { root.ownerDocument.defaultView.location.reload(); } catch(e) {}\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")

  (* New: measure_text_offset *)
  val () = $B.bput(b,"  function batsJsMeasureTextOffset(idPtr, idLen, offset) {\n")
  val () = $B.bput(b,"    const id = readIdFromPtr(idPtr, idLen);\n")
  val () = $B.bput(b,"    const el = getEl(id);\n")
  val () = $B.bput(b,"    if (!el || !el.firstChild) return -1;\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      const range = document.createRange();\n")
  val () = $B.bput(b,"      const textNode = el.firstChild;\n")
  val () = $B.bput(b,"      const clampOff = Math.min(offset, (textNode.textContent || '').length);\n")
  val () = $B.bput(b,"      range.setStart(textNode, clampOff);\n")
  val () = $B.bput(b,"      range.collapse(true);\n")
  val () = $B.bput(b,"      const rect = range.getBoundingClientRect();\n")
  val () = $B.bput(b,"      instance.exports.bats_measure_set(0, Math.round(rect.x));\n")
  val () = $B.bput(b,"      instance.exports.bats_measure_set(1, Math.round(rect.y));\n")
  val () = $B.bput(b,"      return 1;\n")
  val () = $B.bput(b,"    } catch(e) { return -1; }\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  (* New: get_selection_text *)
  val () = $B.bput(b,"  function batsJsGetSelectionText() {\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      const sel = root.ownerDocument.defaultView.getSelection();\n")
  val () = $B.bput(b,"      if (!sel || sel.isCollapsed) return 0;\n")
  val () = $B.bput(b,"      const text = sel.toString();\n")
  val () = $B.bput(b,"      const bytes = new TextEncoder().encode(text);\n")
  val () = $B.bput(b,"      if (bytes.length === 0) return 0;\n")
  val () = $B.bput(b,"      return pendBlob(bytes);\n")
  val () = $B.bput(b,"    } catch(e) { return 0; }\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  (* New: get_selection_rect *)
  val () = $B.bput(b,"  function batsJsGetSelectionRect() {\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      const sel = root.ownerDocument.defaultView.getSelection();\n")
  val () = $B.bput(b,"      if (!sel || sel.rangeCount === 0) return;\n")
  val () = $B.bput(b,"      const rect = sel.getRangeAt(0).getBoundingClientRect();\n")
  val () = $B.bput(b,"      instance.exports.bats_measure_set(0, Math.round(rect.x));\n")
  val () = $B.bput(b,"      instance.exports.bats_measure_set(1, Math.round(rect.y));\n")
  val () = $B.bput(b,"      instance.exports.bats_measure_set(2, Math.round(rect.width));\n")
  val () = $B.bput(b,"      instance.exports.bats_measure_set(3, Math.round(rect.height));\n")
  val () = $B.bput(b,"    } catch(e) {}\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  (* New: get_selection_range *)
  val () = $B.bput(b,"  function batsJsGetSelectionRange() {\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      const sel = root.ownerDocument.defaultView.getSelection();\n")
  val () = $B.bput(b,"      if (!sel || sel.rangeCount === 0) return;\n")
  val () = $B.bput(b,"      const range = sel.getRangeAt(0);\n")
  val () = $B.bput(b,"      instance.exports.bats_measure_set(0, range.startOffset);\n")
  val () = $B.bput(b,"      instance.exports.bats_measure_set(1, range.endOffset);\n")
  val () = $B.bput(b,"      const sc = range.startContainer.parentNode || range.startContainer;\n")
  val () = $B.bput(b,"      const ec = range.endContainer.parentNode || range.endContainer;\n")
  val () = $B.bput(b,"      const sid = (sc.id || '');\n")
  val () = $B.bput(b,"      const eid = (ec.id || '');\n")
  val () = $B.bput(b,"      const sb = new TextEncoder().encode(sid);\n")
  val () = $B.bput(b,"      const eb = new TextEncoder().encode(eid);\n")
  val () = $B.bput(b,"      instance.exports.bats_measure_set(2, pendBlob(sb));\n")
  val () = $B.bput(b,"      instance.exports.bats_measure_set(3, pendBlob(eb));\n")
  val () = $B.bput(b,"    } catch(e) {}\n")
  val () = $B.bput(b,"  }\n")
in end

fn emit_js_event {n:nat | n + 5030 <= $B.BUILDER_CAP}
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 5030] $B.builder(m)): void = let
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // --- Event listener ---\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  const listenerMap = new Map();\n")
  val () = $B.bput(b,"  let currentEvent = null;\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // Every position is a whole number of CSS pixels, as int32 LE\n")
  val () = $B.bput(b,"  function encodeEventPayload(event, eventType) {\n")
  val () = $B.bput(b,"    if (eventType === 'click' || eventType === 'dblclick' || eventType === 'contextmenu' ||\n")
  val () = $B.bput(b,"        eventType === 'pointerdown' || eventType === 'pointerup' || eventType === 'pointermove' ||\n")
  val () = $B.bput(b,"        eventType === 'focusin' || eventType === 'focusout') {\n")
  val () = $B.bput(b,"      const targetId = (event.target && event.target.id) || '';\n")
  val () = $B.bput(b,"      const idBytes = new TextEncoder().encode(targetId);\n")
  val () = $B.bput(b,"      const buf = new ArrayBuffer(8 + 2 + idBytes.length);\n")
  val () = $B.bput(b,"      const dv = new DataView(buf);\n")
  val () = $B.bput(b,"      dv.setInt32(0, Math.round(event.clientX || 0), true);\n")
  val () = $B.bput(b,"      dv.setInt32(4, Math.round(event.clientY || 0), true);\n")
  val () = $B.bput(b,"      dv.setUint16(8, idBytes.length, true);\n")
  val () = $B.bput(b,"      new Uint8Array(buf).set(idBytes, 10);\n")
  val () = $B.bput(b,"      return new Uint8Array(buf);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    if (eventType === 'keydown' || eventType === 'keyup') {\n")
  val () = $B.bput(b,"      const key = event.key || '';\n")
  val () = $B.bput(b,"      const keyBytes = new TextEncoder().encode(key);\n")
  val () = $B.bput(b,"      const buf = new Uint8Array(1 + keyBytes.length + 1);\n")
  val () = $B.bput(b,"      buf[0] = keyBytes.length;\n")
  val () = $B.bput(b,"      buf.set(keyBytes, 1);\n")
  val () = $B.bput(b,"      const flags = (event.shiftKey ? 1 : 0) | (event.ctrlKey ? 2 : 0) |\n")
  val () = $B.bput(b,"                    (event.altKey ? 4 : 0) | (event.metaKey ? 8 : 0);\n")
  val () = $B.bput(b,"      buf[1 + keyBytes.length] = flags;\n")
  val () = $B.bput(b,"      return buf;\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    if (eventType === 'input') {\n")
  val () = $B.bput(b,"      const value = (event.target && event.target.value) || '';\n")
  val () = $B.bput(b,"      const valBytes = new TextEncoder().encode(value);\n")
  val () = $B.bput(b,"      const buf = new Uint8Array(2 + valBytes.length);\n")
  val () = $B.bput(b,"      buf[0] = valBytes.length & 0xFF;\n")
  val () = $B.bput(b,"      buf[1] = (valBytes.length >> 8) & 0xFF;\n")
  val () = $B.bput(b,"      buf.set(valBytes, 2);\n")
  val () = $B.bput(b,"      return buf;\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    if (eventType === 'wheel') {\n")
  val () = $B.bput(b,"      const buf = new ArrayBuffer(8);\n")
  val () = $B.bput(b,"      const dv = new DataView(buf);\n")
  val () = $B.bput(b,"      dv.setInt32(0, Math.round(event.deltaX || 0), true);\n")
  val () = $B.bput(b,"      dv.setInt32(4, Math.round(event.deltaY || 0), true);\n")
  val () = $B.bput(b,"      return new Uint8Array(buf);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    if (eventType === 'scroll') {\n")
  val () = $B.bput(b,"      const buf = new ArrayBuffer(8);\n")
  val () = $B.bput(b,"      const dv = new DataView(buf);\n")
  val () = $B.bput(b,"      const target = event.target || {};\n")
  val () = $B.bput(b,"      dv.setInt32(0, Math.round(target.scrollTop || 0), true);\n")
  val () = $B.bput(b,"      dv.setInt32(4, Math.round(target.scrollLeft || 0), true);\n")
  val () = $B.bput(b,"      return new Uint8Array(buf);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    if (eventType === 'resize') {\n")
  val () = $B.bput(b,"      const buf = new ArrayBuffer(8);\n")
  val () = $B.bput(b,"      const dv = new DataView(buf);\n")
  val () = $B.bput(b,"      const win = root.ownerDocument.defaultView || {};\n")
  val () = $B.bput(b,"      dv.setInt32(0, Math.round(win.innerWidth || 0), true);\n")
  val () = $B.bput(b,"      dv.setInt32(4, Math.round(win.innerHeight || 0), true);\n")
  val () = $B.bput(b,"      return new Uint8Array(buf);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    if (eventType === 'touchstart' || eventType === 'touchend' || eventType === 'touchmove') {\n")
  val () = $B.bput(b,"      const touch = (event.touches && event.touches[0]) ||\n")
  val () = $B.bput(b,"                    (event.changedTouches && event.changedTouches[0]);\n")
  val () = $B.bput(b,"      if (touch) {\n")
  val () = $B.bput(b,"        const buf = new ArrayBuffer(12);\n")
  val () = $B.bput(b,"        const dv = new DataView(buf);\n")
  val () = $B.bput(b,"        dv.setInt32(0, Math.round(touch.clientX || 0), true);\n")
  val () = $B.bput(b,"        dv.setInt32(4, Math.round(touch.clientY || 0), true);\n")
  val () = $B.bput(b,"        dv.setInt32(8, touch.identifier || 0, true);\n")
  val () = $B.bput(b,"        return new Uint8Array(buf);\n")
  val () = $B.bput(b,"      }\n")
  val () = $B.bput(b,"      return null;\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    if (eventType === 'drop') {\n")
  val () = $B.bput(b,"      droppedFiles = Array.from((event.dataTransfer && event.dataTransfer.files) || []);\n")
  val () = $B.bput(b,"      return new Uint8Array([Math.min(droppedFiles.length, 255)]);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    if (eventType === 'visibilitychange') {\n")
  val () = $B.bput(b,"      return new Uint8Array([document.visibilityState === 'hidden' ? 1 : 0]);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    return null;\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsFireEvent(listenerId, event, eventType) {\n")
  val () = $B.bput(b,"    currentEvent = event;\n")
  val () = $B.bput(b,"    const payload = encodeEventPayload(event, eventType);\n")
  val () = $B.bput(b,"    const handle = payload ? nextBlobHandle++ : 0;\n")
  val () = $B.bput(b,"    if (payload) pendingBlobs.set(handle, payload);\n")
  val () = $B.bput(b,"    instance.exports.bats_on_event(listenerId, handle);\n")
  val () = $B.bput(b,"    pendingBlobs.delete(handle);\n")
  val () = $B.bput(b,"    currentEvent = null;\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsAddEventListener(idPtr, idLen, eventTypePtr, typeLen, listenerId) {\n")
  val () = $B.bput(b,"    const id = readIdFromPtr(idPtr, idLen);\n")
  val () = $B.bput(b,"    const node = getEl(id);\n")
  val () = $B.bput(b,"    if (!node) return;\n")
  val () = $B.bput(b,"    const eventType = readString(eventTypePtr, typeLen);\n")
  val () = $B.bput(b,"    const handler = (event) => batsJsFireEvent(listenerId, event, eventType);\n")
  val () = $B.bput(b,"    listenerMap.set(listenerId, { node, eventType, handler });\n")
  val () = $B.bput(b,"    node.addEventListener(eventType, handler);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  (* New: listen on document *)
  val () = $B.bput(b,"  function batsJsAddDocumentListener(eventTypePtr, typeLen, listenerId) {\n")
  val () = $B.bput(b,"    const eventType = readString(eventTypePtr, typeLen);\n")
  val () = $B.bput(b,"    const handler = (event) => batsJsFireEvent(listenerId, event, eventType);\n")
  val () = $B.bput(b,"    listenerMap.set(listenerId, { node: document, eventType, handler });\n")
  val () = $B.bput(b,"    document.addEventListener(eventType, handler);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsRemoveEventListener(listenerId) {\n")
  val () = $B.bput(b,"    const entry = listenerMap.get(listenerId);\n")
  val () = $B.bput(b,"    if (entry) {\n")
  val () = $B.bput(b,"      entry.node.removeEventListener(entry.eventType, entry.handler);\n")
  val () = $B.bput(b,"      listenerMap.delete(listenerId);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsPreventDefault() {\n")
  val () = $B.bput(b,"    if (currentEvent) currentEvent.preventDefault();\n")
  val () = $B.bput(b,"  }\n")
in end

fn emit_js_fetch {n:nat | n + 1610 <= $B.BUILDER_CAP}
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 1610] $B.builder(m)): void = let
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // --- Fetch ---\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // A response (its status and headers), until it is let go (release)\n")
  val () = $B.bput(b,"  const fetchResponses = new Map();\n")
  val () = $B.bput(b,"  function batsJsFetchStatus(h) {\n")
  val () = $B.bput(b,"    const r = fetchResponses.get(h);\n")
  val () = $B.bput(b,"    return r ? r.status : -1;\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsFetchRelease(h) { fetchResponses.delete(h); }\n")
  (* The body h as a pending file under a new handle (0 when there is
     none): the Uint8Array moves, nothing is copied *)
  val () = $B.bput(b,"  function batsJsFetchFile(h) {\n")
  val () = $B.bput(b,"    const d = pendingBlobs.get(h), f = d ? nextFileHandle++ : 0;\n")
  val () = $B.bput(b,"    if (d) { pendingBlobs.delete(h); pendingFiles.set(f, d); }\n")
  val () = $B.bput(b,"    return f;\n")
  val () = $B.bput(b,"  }\n")
  (* -1 when the header is absent, longer than the buffer, not exposed
     by CORS, or its name is not a valid one *)
  val () = $B.bput(b,"  function batsJsFetchHeader(h, p, l, o, m) {\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      const s = fetchResponses.get(h).headers.get(readString(p, l));\n")
  val () = $B.bput(b,"      return s === null || new TextEncoder().encode(s).length > m ? -1 : writeStringToWasm(s, o, m);\n")
  val () = $B.bput(b,"    } catch (e) { return -1; }\n")
  val () = $B.bput(b,"  }\n")
  (* The caller reads its arguments at once; a throw of fetch, even a
     synchronous one, resolves 0 *)
  val () = $B.bput(b,"  async function fetchDeliver(url, init, i) {\n")
  val () = $B.bput(b,"    let h = 0;\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      const r = await fetch(url, init);\n")
  val () = $B.bput(b,"      h = pendBlob(new Uint8Array(await r.arrayBuffer()));\n")
  val () = $B.bput(b,"      fetchResponses.set(h, r);\n")
  val () = $B.bput(b,"    } catch (e) {}\n")
  val () = $B.bput(b,"    instance.exports.bats_on_fetch_complete(i, h);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsFetch(p, l, i) {\n")
  val () = $B.bput(b,"    fetchDeliver(readString(p, l), {}, i);\n")
  val () = $B.bput(b,"  }\n")
  (* Headers are [name, value] pairs; the body is left out when empty *)
  val () = $B.bput(b,"  function fetchSend(mp, ml, up, ul, h, bp, bl, i) {\n")
  val () = $B.bput(b,"    fetchDeliver(readString(up, ul), { method: readString(mp, ml), headers: h,\n")
  val () = $B.bput(b,"      body: bl > 0 ? readBytes(bp, bl) : null, cache: 'no-store' }, i);\n")
  val () = $B.bput(b,"  }\n")
  (* Header lines, split at a newline (the template literal holds one),
     then at their first colon, each side trimmed; a line with no name
     is skipped *)
  val () = $B.bput(b,"  function batsJsFetchRequest(mp, ml, up, ul, hp, hl, bp, bl, i) {\n")
  val () = $B.bput(b,"    const h = [];\n")
  val () = $B.bput(b,"    for (const s of readString(hp, hl).split(`\n`)) {\n")
  val () = $B.bput(b,"      const c = s.indexOf(':'), n = s.slice(0, c).trim();\n")
  val () = $B.bput(b,"      if (c > 0 && n) h.push([n, s.slice(c + 1).trim()]);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    fetchSend(mp, ml, up, ul, h, bp, bl, i);\n")
  val () = $B.bput(b,"  }\n")
in end

fn emit_js_clipboard {n:nat | n + 1390 <= $B.BUILDER_CAP}
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 1390] $B.builder(m)): void = let
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // --- Clipboard ---\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsClipboardWriteText(textPtr, textLen, resolverId) {\n")
  val () = $B.bput(b,"    const text = readString(textPtr, textLen);\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      const win = root.ownerDocument.defaultView;\n")
  val () = $B.bput(b,"      if (win && win.navigator && win.navigator.clipboard) {\n")
  val () = $B.bput(b,"        win.navigator.clipboard.writeText(text).then(\n")
  val () = $B.bput(b,"          () => { instance.exports.bats_on_clipboard_complete(resolverId, 1); },\n")
  val () = $B.bput(b,"          () => { instance.exports.bats_on_clipboard_complete(resolverId, 0); }\n")
  val () = $B.bput(b,"        );\n")
  val () = $B.bput(b,"      } else {\n")
  val () = $B.bput(b,"        instance.exports.bats_on_clipboard_complete(resolverId, 0);\n")
  val () = $B.bput(b,"      }\n")
  val () = $B.bput(b,"    } catch(e) {\n")
  val () = $B.bput(b,"      instance.exports.bats_on_clipboard_complete(resolverId, 0);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  (* New: clipboard read *)
  val () = $B.bput(b,"  function batsJsClipboardReadText(resolverId) {\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      const win = root.ownerDocument.defaultView;\n")
  val () = $B.bput(b,"      if (win && win.navigator && win.navigator.clipboard) {\n")
  val () = $B.bput(b,"        win.navigator.clipboard.readText().then(\n")
  val () = $B.bput(b,"          (text) => {\n")
  val () = $B.bput(b,"            const bytes = new TextEncoder().encode(text);\n")
  val () = $B.bput(b,"            instance.exports.bats_on_clipboard_read_complete(resolverId, bytes.length ? pendBlob(bytes) : 0);\n")
  val () = $B.bput(b,"          },\n")
  val () = $B.bput(b,"          () => { instance.exports.bats_on_clipboard_read_complete(resolverId, -1); }\n")
  val () = $B.bput(b,"        );\n")
  val () = $B.bput(b,"      } else {\n")
  val () = $B.bput(b,"        instance.exports.bats_on_clipboard_read_complete(resolverId, -1);\n")
  val () = $B.bput(b,"      }\n")
  val () = $B.bput(b,"    } catch(e) {\n")
  val () = $B.bput(b,"      instance.exports.bats_on_clipboard_read_complete(resolverId, -1);\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"  }\n")
in end

fn emit_js_file {n:nat | n + 2690 <= $B.BUILDER_CAP}
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 2690] $B.builder(m)): void = let
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // --- File ---\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // A file waits in pendingFiles until claimed, then lives in fileCache\n")
  val () = $B.bput(b,"  // until closed; each is claimed at most once\n")
  val () = $B.bput(b,"  const pendingFiles = new Map();\n")
  val () = $B.bput(b,"  const fileCache = new Map();\n")
  val () = $B.bput(b,"  let nextFileHandle = 1;\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsFileOpen(idPtr, idLen, resolverId) {\n")
  val () = $B.bput(b,"    const el = getEl(readIdFromPtr(idPtr, idLen));\n")
  val () = $B.bput(b,"    batsJsReadFileObj(el && el.files ? el.files[0] : null, resolverId);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsFileClaim(handle) {\n")
  val () = $B.bput(b,"    const data = pendingFiles.get(handle);\n")
  val () = $B.bput(b,"    if (!data) return -1;\n")
  val () = $B.bput(b,"    pendingFiles.delete(handle);\n")
  val () = $B.bput(b,"    fileCache.set(handle, data);\n")
  val () = $B.bput(b,"    return data.length;\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsFileRead(handle, fileOffset, len, outPtr) {\n")
  val () = $B.bput(b,"    new Uint8Array(instance.exports.memory.buffer).set(\n")
  val () = $B.bput(b,"      fileCache.get(handle).subarray(fileOffset, fileOffset + len), outPtr);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsFileClose(handle) {\n")
  val () = $B.bput(b,"    fileCache.delete(handle); fileNames.delete(handle);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsFileIdbPut(keyPtr, keyLen, handle, resolverId) {\n")
  val () = $B.bput(b,"    const key = readString(keyPtr, keyLen); const data = fileCache.get(handle);\n")
  val () = $B.bput(b,"    openDB().then(db => { const tx = db.transaction('kv', 'readwrite'); tx.objectStore('kv').put(data, key);\n")
  val () = $B.bput(b,"      tx.oncomplete = () => instance.exports.bats_on_file_open(resolverId, 0);\n")
  val () = $B.bput(b,"      tx.onabort = () => instance.exports.bats_on_file_open(resolverId, -1);\n")
  val () = $B.bput(b,"    }, () => instance.exports.bats_on_file_open(resolverId, -1));\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsFileIdbGet(keyPtr, keyLen, resolverId) {\n")
  val () = $B.bput(b,"    const key = readString(keyPtr, keyLen);\n")
  val () = $B.bput(b,"    openDB().then(db => { const req = db.transaction('kv', 'readonly').objectStore('kv').get(key);\n")
  val () = $B.bput(b,"      req.onsuccess = () => { if (req.result === undefined) { instance.exports.bats_on_file_open(resolverId, 0); return; }\n")
  val () = $B.bput(b,"        const handle = nextFileHandle++; pendingFiles.set(handle, new Uint8Array(req.result));\n")
  val () = $B.bput(b,"        instance.exports.bats_on_file_open(resolverId, handle); };\n")
  val () = $B.bput(b,"      req.onerror = () => instance.exports.bats_on_file_open(resolverId, -1);\n")
  val () = $B.bput(b,"    }, () => instance.exports.bats_on_file_open(resolverId, -1));\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"  function batsJsFileStore(dataPtr, dataLen) {\n")
  val () = $B.bput(b,"    const src = new Uint8Array(instance.exports.memory.buffer, dataPtr, dataLen);\n")
  val () = $B.bput(b,"    const copy = new Uint8Array(dataLen);\n")
  val () = $B.bput(b,"    copy.set(src);\n")
  val () = $B.bput(b,"    const handle = nextFileHandle++;\n")
  val () = $B.bput(b,"    fileCache.set(handle, copy);\n")
  val () = $B.bput(b,"    return handle;\n")
  val () = $B.bput(b,"  }\n")
  (* The Blob is made from a view of the cached bytes: nothing is
     copied through wasm memory *)
  val () = $B.bput(b,"  function batsJsFileBlobUrl(handle, fileOffset, len, mimePtr, mimeLen) {\n")
  val () = $B.bput(b,"    const data = fileCache.get(handle);\n")
  val () = $B.bput(b,"    if (!data) return 0;\n")
  val () = $B.bput(b,"    try {\n")
  val () = $B.bput(b,"      const blob = new Blob([data.subarray(fileOffset, fileOffset + len)], { type: readString(mimePtr, mimeLen) });\n")
  val () = $B.bput(b,"      return pendBlob(new TextEncoder().encode(URL.createObjectURL(blob)));\n")
  val () = $B.bput(b,"    } catch(e) { return 0; }\n")
  val () = $B.bput(b,"  }\n")
in end

fn emit_js_decompress {n:nat | n + 2400 <= $B.BUILDER_CAP}
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 2400] $B.builder(m)): void = let
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // --- Decompress ---\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // A blob waits in pendingBlobs until claimed, then lives in blobCache\n")
  val () = $B.bput(b,"  // until freed; each is claimed at most once\n")
  val () = $B.bput(b,"  const pendingBlobs = new Map();\n")
  val () = $B.bput(b,"  const blobCache = new Map();\n")
  val () = $B.bput(b,"  let nextBlobHandle = 1;\n")
  val () = $B.bput(b,"  function pendBlob(bytes) {\n")
  val () = $B.bput(b,"    const handle = nextBlobHandle++;\n")
  val () = $B.bput(b,"    pendingBlobs.set(handle, bytes);\n")
  val () = $B.bput(b,"    return handle;\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsDecompress(dataPtr, dataLen, method, resolverId) {\n")
  val () = $B.bput(b,"    const compressed = readBytes(dataPtr, dataLen);\n")
  val () = $B.bput(b,"    if (method === 0) {\n")
  val () = $B.bput(b,"      const handle = nextBlobHandle++;\n")
  val () = $B.bput(b,"      pendingBlobs.set(handle, compressed);\n")
  val () = $B.bput(b,"      instance.exports.bats_on_decompress_complete(resolverId, handle);\n")
  val () = $B.bput(b,"      return;\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    const fmtMap = {1:'gzip',2:'deflate',8:'deflate-raw'};\n")
  val () = $B.bput(b,"    const format = fmtMap[method];\n")
  val () = $B.bput(b,"    if (!format || typeof DecompressionStream === 'undefined') {\n")
  val () = $B.bput(b,"      instance.exports.bats_on_decompress_complete(resolverId, 0);\n")
  val () = $B.bput(b,"      return;\n")
  val () = $B.bput(b,"    }\n")
  val () = $B.bput(b,"    const ds = new DecompressionStream(format);\n")
  val () = $B.bput(b,"    const writer = ds.writable.getWriter();\n")
  val () = $B.bput(b,"    // damaged data rejects these too; the reader's failure reports it\n")
  val () = $B.bput(b,"    writer.write(compressed).catch(() => {});\n")
  val () = $B.bput(b,"    writer.close().catch(() => {});\n")
  val () = $B.bput(b,"    const reader = ds.readable.getReader();\n")
  val () = $B.bput(b,"    const chunks = [];\n")
  val () = $B.bput(b,"    (function pump() {\n")
  val () = $B.bput(b,"      reader.read().then(({ done, value }) => {\n")
  val () = $B.bput(b,"        if (value) chunks.push(value);\n")
  val () = $B.bput(b,"        if (done) {\n")
  val () = $B.bput(b,"          let totalLen = 0;\n")
  val () = $B.bput(b,"          for (const c of chunks) totalLen += c.length;\n")
  val () = $B.bput(b,"          const result = new Uint8Array(totalLen);\n")
  val () = $B.bput(b,"          let off = 0;\n")
  val () = $B.bput(b,"          for (const c of chunks) { result.set(c, off); off += c.length; }\n")
  val () = $B.bput(b,"          const handle = nextBlobHandle++;\n")
  val () = $B.bput(b,"          pendingBlobs.set(handle, result);\n")
  val () = $B.bput(b,"          instance.exports.bats_on_decompress_complete(resolverId, handle);\n")
  val () = $B.bput(b,"        } else {\n")
  val () = $B.bput(b,"          pump();\n")
  val () = $B.bput(b,"        }\n")
  val () = $B.bput(b,"      }).catch(() => {\n")
  val () = $B.bput(b,"        instance.exports.bats_on_decompress_complete(resolverId, 0);\n")
  val () = $B.bput(b,"      });\n")
  val () = $B.bput(b,"    })();\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsBlobClaim(handle) {\n")
  val () = $B.bput(b,"    const data = pendingBlobs.get(handle);\n")
  val () = $B.bput(b,"    if (!data) return -1;\n")
  val () = $B.bput(b,"    pendingBlobs.delete(handle);\n")
  val () = $B.bput(b,"    blobCache.set(handle, data);\n")
  val () = $B.bput(b,"    return data.length;\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsBlobRead(handle, blobOffset, len, outPtr) {\n")
  val () = $B.bput(b,"    new Uint8Array(instance.exports.memory.buffer).set(\n")
  val () = $B.bput(b,"      blobCache.get(handle).subarray(blobOffset, blobOffset + len), outPtr);\n")
  val () = $B.bput(b,"  }\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  function batsJsBlobFree(handle) {\n")
  val () = $B.bput(b,"    blobCache.delete(handle);\n")
  val () = $B.bput(b,"  }\n")
in end

fn emit_js_notify {n:nat | n + 2110 <= $B.BUILDER_CAP}
  (b: !$B.builder(n) >> [m:nat | n <= m; m <= n + 2110] $B.builder(m)): void = let
