  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // Sharing: navigator.share in a browser, else the app's Share (a file\n")
  val () = $B.bput(b,"  // through its Filesystem). 0 shared, 1 cancelled, 2 failed, 3 a file\n")
  val () = $B.bput(b,"  // this platform cannot share\n")
