  val () = $B.bput(b,"  const view = root.ownerDocument.defaultView || globalThis;\n")
  val () = $B.bput(b,"\n")
  val () = $B.bput(b,"  // Full screen: the Fullscreen API in a browser; in the app, the status\n")
